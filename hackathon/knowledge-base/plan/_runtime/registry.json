{
  "version": "demo-registry-1",
  "source": {
    "server": "local-demo",
    "database": "planning-demo",
    "schema": "demo",
    "watermarkRule": "Use the latest approved demo snapshot."
  },
  "loadDefaults": {
    "retainSnapshots": 1,
    "columnPolicy": "Load only approved demo columns."
  },
  "outOfDomainTerms": ["pricing", "personal data"],
  "views": [
    {
      "objectRef": "plan/objects/demo-demand",
      "view": "demo_demand",
      "entity": "Demand",
      "domain": "planning",
      "cadence": "daily",
      "inScope": true,
      "dqGated": false,
      "accessStatus": "granted",
      "reportCoverage": ["Demo Planning Report"],
      "sensitivity": "Synthetic Public Demo",
      "snapshot": {
        "mode": "LatestSnapshot",
        "runDateColumn": "snapshot_date"
      },
      "measures": [
        {
          "key": "planning.demand",
          "metric_code": "DEMO-001",
          "unit": "units",
          "column": "quantity",
          "qualifier": "Approved synthetic demand quantity",
          "explanation": "Adds the quantity in synthetic demand records for the selected period.",
          "horizon": "by planning period",
          "dateColumn": "period",
          "analysisDimensions": ["product_family", "period"],
          "aggregate": "sum"
        },
        {
          "key": "planning.coverage",
          "metric_code": "DEMO-002",
          "unit": "percent",
          "column": "coverage_percent",
          "qualifier": "Synthetic supply coverage percentage",
          "explanation": "For the same product family, period and snapshot, divide total synthetic supportable_quantity by total quantity and multiply by 100. Zero demand is undefined, not zero percent.",
          "businessRule": "100 * SUM(supportable_quantity) / SUM(quantity); undefined when SUM(quantity) = 0. Do not average row percentages.",
          "horizon": "for the selected period",
          "analysisDimensions": ["product_family", "period"],
          "aggregate": "ratio"
        }
      ]
    }
  ]
}
